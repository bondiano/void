<form action="/signup" method="post"><div class="field field-age field-invalid"><label for="field-age">Age</label><input id="field-age" max="130" min="18" name="age" required type="number" value="12"/><ul class="field-errors"><li>[:age]: expected at least 18, got 12</li></ul></div><div class="field field-bio"><label for="field-bio">Bio</label><textarea id="field-bio" maxlength="200" name="bio"></textarea></div><div class="field field-email field-invalid"><label for="field-email">Email</label><input id="field-email" name="email" required type="email" value="nope"/><ul class="field-errors"><li>[:email]: &quot;nope&quot; is not a valid :email</li></ul></div><div class="field field-role"><label for="field-role">Role</label><select id="field-role" name="role" required><option value="admin">Admin</option><option selected value="user">User</option></select></div><div class="field field-subscribed"><label for="field-subscribed">Subscribed</label><input id="field-subscribed" name="subscribed" type="checkbox" value="true"/></div><button type="submit">Save</button></form>