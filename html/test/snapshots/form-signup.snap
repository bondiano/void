<form action="/signup" method="post"><div class="field field-age field-invalid"><label for="field-age">Age</label><input required="true" id="field-age" min="18" name="age" max="130" value="12" type="number"/><ul class="field-errors"><li>[:age]: expected at least 18, got 12</li></ul></div><div class="field field-bio"><label for="field-bio">Bio</label><textarea id="field-bio" name="bio" maxlength="200"></textarea></div><div class="field field-email field-invalid"><label for="field-email">Email</label><input required="true" id="field-email" name="email" value="nope" type="email"/><ul class="field-errors"><li>[:email]: &quot;nope&quot; is not a valid :email</li></ul></div><div class="field field-role"><label for="field-role">Role</label><select id="field-role" name="role" required="true"><option value="admin">Admin</option><option value="user" selected="true">User</option></select></div><div class="field field-subscribed"><label for="field-subscribed">Subscribed</label><input id="field-subscribed" name="subscribed" value="true" type="checkbox"/></div><button type="submit">Save</button></form>