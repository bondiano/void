# jpm / janet build artifacts
build/
jpm_tree/

# the bundle installed into a tree of its own (scripts/install-tree.janet):
# what examples/hub imports from, and never part of the repository
.void-tree/
*.so
*.dylib
*.o
*.a
*.jimage

# test sandboxes (cleaned up on success, left behind by a crash)
.tmp-*/

# sqlite databases (void/db-sqlite's default path is db/void.sqlite3)
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# the generated docs site (scripts/gen-site.janet); published to
# GitHub Pages by .github/workflows/site.yml, never committed.
# Anchored: scripts/site/ is the generator's own source
/site/

# the design record kept out of the published repository: the
# specification, the wave plan and the decision records. They stay on disk
# under docs/internal/ — written and read locally, never part of what the
# repository or the docs site ships.
docs/internal/

# OMC session state
.omc/

# OS / editors
.DS_Store
.idea/
.vscode/
